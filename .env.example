# Copy this file to .env and fill in the values.
# Never commit .env to git.

# PostgreSQL (used by api and worker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/repoatlas

# Redis (queue, sessions, cache, pub/sub)
REDIS_URL=redis://localhost:6379/0

# GitHub OAuth (create an OAuth App at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random secret for signing session cookies (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SESSION_SECRET=

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Embedding provider (decided in P3-S01)
EMBEDDING_PROVIDER=

# Origins for CORS
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
